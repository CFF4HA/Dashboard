digraph flow_product_htmx {
  rankdir=TB
  graph [
    label="UML Sequence — product-search_results: HTMX Actions\n(search · detail · update · delete · star)",
    labelloc=t, labeljust=l,
    fontname="Helvetica", fontsize=12,
    nodesep=2.0, ranksep=0.6,
    splines=polyline, pad=0.5
  ]
  node [fontname="Helvetica", fontsize=10, height=0.5]
  edge [fontname="Helvetica", fontsize=9, arrowsize=0.75]

  // ── Lifelines ─────────────────────────────────────────────────────────────
  { rank=min
    Browser [label="Browser",                                   shape=rect,     style="filled,rounded", fillcolor="#fff196"]
    Handler [label="Standard Handler\ninternal/handlers/product", shape=rect,  style="filled,rounded", fillcolor="#96b1ff"]
    DB      [label="PostgreSQL",                                 shape=cylinder, style=filled,           fillcolor="#ffcccc"]
  }

  // ── Lifeline step nodes ───────────────────────────────────────────────────
  node [shape=point, width=0.04, height=0.04, label=""]

  // ── Lifeline chains ───────────────────────────────────────────────────────
  edge [style=dashed, arrowhead=none, color="#cccccc", weight=20]
  Browser -> b0 -> b1 -> b2 -> b3
  Handler -> h0 -> h1 -> h2 -> h3
  DB      -> d0 -> d1 -> d2 -> d3

  // ── Step alignment ────────────────────────────────────────────────────────
  { rank=same; b0; h0; d0 }
  { rank=same; b1; h1; d1 }
  { rank=same; b2; h2; d2 }
  { rank=same; b3; h3; d3 }

  // ── Messages ──────────────────────────────────────────────────────────────
  edge [constraint=false, fontsize=9]
  b0 -> h0 [label="  HTMX GET / POST / DELETE\n(/htmx/product-search_results\n/htmx/product-detail\n/product/update · /product/delete · /user/product)  ", style=solid,  color="#198754", fontcolor="#198754"]
  h1 -> d1 [label="  SELECT / INSERT / UPDATE / DELETE  ",                                                                                                    style=solid,  color="#198754", fontcolor="#198754"]
  d2 -> h2 [label="  result  ",                                                                                                                                style=dashed, color="#198754", fontcolor="#198754"]
  h3 -> b3 [label="  partial HTML (results · card · modal · star)  ",                                                                                         style=dashed, color="#198754", fontcolor="#198754"]
}

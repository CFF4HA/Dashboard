digraph flow_product_render {
  rankdir=TB
  graph [
    label="UML Sequence — product-search_results: Page Render (GET /products)",
    labelloc=t, labeljust=l,
    fontname="Helvetica", fontsize=12,
    nodesep=2.0, ranksep=0.6,
    splines=polyline, pad=0.5
  ]
  node [fontname="Helvetica", fontsize=10, height=0.5]
  edge [fontname="Helvetica", fontsize=9, arrowsize=0.75]

  // ── Lifelines ─────────────────────────────────────────────────────────────
  { rank=min
    Browser    [label="Browser",                                    shape=rect,     style="filled,rounded", fillcolor="#fff196"]
    ProdBridge [label="Product Bridge\ninternal/bridges/product.go", shape=rect,   style="filled,rounded", fillcolor="#96b1ff"]
    DB         [label="PostgreSQL",                                  shape=cylinder, style=filled,           fillcolor="#ffcccc"]
  }

  // ── Lifeline step nodes ───────────────────────────────────────────────────
  node [shape=point, width=0.04, height=0.04, label=""]

  // ── Lifeline chains ───────────────────────────────────────────────────────
  edge [style=dashed, arrowhead=none, color="#cccccc", weight=20]
  Browser    -> b0 -> b1 -> b2 -> b3
  ProdBridge -> p0 -> p1 -> p2 -> p3
  DB         -> d0 -> d1 -> d2 -> d3

  // ── Step alignment ────────────────────────────────────────────────────────
  { rank=same; b0; p0; d0 }
  { rank=same; b1; p1; d1 }
  { rank=same; b2; p2; d2 }
  { rank=same; b3; p3; d3 }

  // ── Messages ──────────────────────────────────────────────────────────────
  edge [constraint=false, fontsize=9]
  b0 -> p0 [label="  GET /products  ",                                                          style=solid,  color="#4477CC", fontcolor="#4477CC"]
  p1 -> d1 [label="  SELECT products + ingredients\n+ tags + favorites + categories  ",        style=solid,  color="#4477CC", fontcolor="#4477CC"]
  d2 -> p2 [label="  rows  ",                                                                   style=dashed, color="#4477CC", fontcolor="#4477CC"]
  p3 -> b3 [label="  full HTML  ",                                                              style=dashed, color="#4477CC", fontcolor="#4477CC"]
}

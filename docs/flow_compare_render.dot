digraph flow_compare_render {
  rankdir=TB
  graph [
    label="UML Sequence — compare-product_card: Page Render (GET /compare)",
    labelloc=t, labeljust=l,
    fontname="Helvetica", fontsize=12,
    nodesep=1.2, ranksep=0.6,
    splines=line, pad=0.5
  ]
  node [fontname="Helvetica", fontsize=10, height=0.5]
  edge [fontname="Helvetica", fontsize=9, arrowsize=0.75]

  // ── Lifelines ─────────────────────────────────────────────────────────────
  { rank=min
    Browser   [label="Browser",                                          shape=rect,     style="filled,rounded", fillcolor="#fff196"]
    InvBridge [label="Investigation Bridge\ninternal/bridges/investigation.go", shape=rect, style="filled,rounded", fillcolor="#96b1ff"]
    DB        [label="PostgreSQL",                                        shape=cylinder, style=filled,           fillcolor="#ffcccc"]
  }

  // ── Lifeline step nodes ───────────────────────────────────────────────────
  node [shape=point, width=0.04, height=0.04, label=""]

  // ── Lifeline chains ───────────────────────────────────────────────────────
  edge [style=dashed, arrowhead=none, color="#cccccc", weight=20]
  Browser   -> b0 -> b1 -> b2 -> b3
  InvBridge -> i0 -> i1 -> i2 -> i3
  DB        -> d0 -> d1 -> d2 -> d3

  // ── Step alignment ────────────────────────────────────────────────────────
  { rank=same; b0; i0; d0 }
  { rank=same; b1; i1; d1 }
  { rank=same; b2; i2; d2 }
  { rank=same; b3; i3; d3 }

  // ── Messages ──────────────────────────────────────────────────────────────
  edge [constraint=false, fontsize=9]
  b0 -> i0 [label="  GET /compare  \n",                                 style=solid,  color="#4477CC", fontcolor="#4477CC"]
  i1 -> d1 [label="  SELECT products + ingredients  \n",                style=solid,  color="#4477CC", fontcolor="#4477CC"]
  d2 -> i2 [label="  rows  \n",                                          style=dashed, color="#4477CC", fontcolor="#4477CC"]
  i3 -> b3 [label="  full HTML +\nwindow.__cpcProductIngredients  \n",  style=dashed, color="#4477CC", fontcolor="#4477CC"]
}

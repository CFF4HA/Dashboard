digraph flow_tagging_remove {
  rankdir=TB
  graph [
    label="UML Sequence — Tagging: Remove Ingredient Tag (with product cascade)",
    labelloc=t, labeljust=l,
    fontname="Helvetica", fontsize=12,
    nodesep=1.2, ranksep=0.6,
    splines=line, pad=0.5
  ]
  node [fontname="Helvetica", fontsize=10, height=0.5]
  edge [fontname="Helvetica", fontsize=9, arrowsize=0.75]

  // ── Lifelines ─────────────────────────────────────────────────────────────
  { rank=min
    Browser [label="Browser",                                                   shape=rect,     style="filled,rounded", fillcolor="#fff196"]
    Handler [label="Remove Tag Handler\ninternal/handlers/tagging/remove_ingredient_tag.go", shape=rect, style="filled,rounded", fillcolor="#96b1ff"]
    DB      [label="PostgreSQL",                                                 shape=cylinder, style=filled,           fillcolor="#ffcccc"]
  }

  // ── Lifeline step nodes ───────────────────────────────────────────────────
  node [shape=point, width=0.04, height=0.04, label=""]

  // ── Lifeline chains ───────────────────────────────────────────────────────
  edge [style=dashed, arrowhead=none, color="#cccccc", weight=20]
  Browser -> b0 -> b1 -> b2 -> b3 -> b4 -> b5 -> b6
  Handler -> h0 -> h1 -> h2 -> h3 -> h4 -> h5 -> h6
  DB      -> d0 -> d1 -> d2 -> d3 -> d4 -> d5 -> d6

  // ── Step alignment ────────────────────────────────────────────────────────
  { rank=same; b0; h0; d0 }
  { rank=same; b1; h1; d1 }
  { rank=same; b2; h2; d2 }
  { rank=same; b3; h3; d3 }
  { rank=same; b4; h4; d4 }
  { rank=same; b5; h5; d5 }
  { rank=same; b6; h6; d6 }

  // ── Messages ──────────────────────────────────────────────────────────────
  edge [constraint=false, fontsize=9]

  // Remove the ingredient → tag association
  b0 -> h0 [label="  DELETE /ingredient/tag (ingredient_id, tag_id)  \n",              style=solid,  color="#dc3545", fontcolor="#dc3545"]
  h1 -> d1 [label="  DELETE ingredient_tag  \n",                                        style=solid,  color="#dc3545", fontcolor="#dc3545"]

  // Find products affected by the removal
  h2 -> d2 [label="  SELECT products WHERE ingredient_id = ? AND tag_id = ?  \n",     style=solid,  color="#EE7722", fontcolor="#EE7722"]
  d3 -> h3 [label="  affected product list  \n",                                        style=dashed, color="#EE7722", fontcolor="#EE7722"]

  // For each product: only remove the product tag if no other ingredients still carry it
  h4 -> d4 [label="  SELECT COUNT(other ingredients with tag) per product\n← loop: one check per affected product  \n", style=solid, color="#EE7722", fontcolor="#EE7722"]
  d5 -> h5 [label="  counts  \n",                                                       style=dashed, color="#EE7722", fontcolor="#EE7722"]
  h5 -> d5 [label="  DELETE product_tag WHERE count = 0 (cascade removal)  \n",        style=solid,  color="#dc3545", fontcolor="#dc3545"]

  h6 -> b6 [label="  200 OK  \n",                                                        style=dashed, color="#198754", fontcolor="#198754"]
}

digraph flow_user_add_product {
  rankdir=TB
  graph [
    label="UML Sequence — Add Product with PubChem Ingredient Retrieval",
    labelloc=t, labeljust=l,
    fontname="Helvetica", fontsize=12,
    nodesep=1.2, ranksep=0.7,
    splines=line, pad=0.6
  ]
  node [fontname="Helvetica", fontsize=10, height=0.5]
  edge [fontname="Helvetica", fontsize=9, arrowsize=0.75]

  // ── Lifelines ─────────────────────────────────────────────────────────────
  { rank=min
    Browser [label="Browser",                                                shape=rect,     style="filled,rounded",       fillcolor="#fff196"]
    ProdH   [label="Product Handler\ninternal/handlers/product\n+ ingredient/create.go", shape=rect, style="filled,rounded", fillcolor="#96b1ff"]
    PubChem [label="PubChem REST API",                                       shape=rect,     style="filled,dashed,rounded", fillcolor="#e9ecef"]
    DB      [label="PostgreSQL",                                              shape=cylinder, style=filled,                 fillcolor="#ffcccc"]
    Bridge  [label="Product Bridge\ninternal/bridges/product.go",            shape=rect,     style="filled,rounded",       fillcolor="#96b1ff"]
    Tmpl    [label="Template\ntemplates/v2/**",                              shape=rect,     style="filled,rounded",       fillcolor="#96b1ff"]
  }

  // ── Lifeline step nodes ───────────────────────────────────────────────────
  node [shape=point, width=0.04, height=0.04, label=""]

  // ── Lifeline chains (dashed vertical) ────────────────────────────────────
  edge [style=dashed, arrowhead=none, color="#cccccc", weight=20]
  Browser -> b0  -> b1  -> b2  -> b3  -> b4  -> b5  -> b6  -> b7  -> b8  -> b9  -> b10 -> b11
  ProdH   -> p0  -> p1  -> p2  -> p3  -> p4  -> p5  -> p6  -> p7  -> p8  -> p9  -> p10 -> p11
  PubChem -> c0  -> c1  -> c2  -> c3  -> c4  -> c5  -> c6  -> c7  -> c8  -> c9  -> c10 -> c11
  DB      -> d0  -> d1  -> d2  -> d3  -> d4  -> d5  -> d6  -> d7  -> d8  -> d9  -> d10 -> d11
  Bridge  -> r0  -> r1  -> r2  -> r3  -> r4  -> r5  -> r6  -> r7  -> r8  -> r9  -> r10 -> r11
  Tmpl    -> t0  -> t1  -> t2  -> t3  -> t4  -> t5  -> t6  -> t7  -> t8  -> t9  -> t10 -> t11

  // ── Step alignment ────────────────────────────────────────────────────────
  { rank=same; b0;  p0;  c0;  d0;  r0;  t0  }
  { rank=same; b1;  p1;  c1;  d1;  r1;  t1  }
  { rank=same; b2;  p2;  c2;  d2;  r2;  t2  }
  { rank=same; b3;  p3;  c3;  d3;  r3;  t3  }
  { rank=same; b4;  p4;  c4;  d4;  r4;  t4  }
  { rank=same; b5;  p5;  c5;  d5;  r5;  t5  }
  { rank=same; b6;  p6;  c6;  d6;  r6;  t6  }
  { rank=same; b7;  p7;  c7;  d7;  r7;  t7  }
  { rank=same; b8;  p8;  c8;  d8;  r8;  t8  }
  { rank=same; b9;  p9;  c9;  d9;  r9;  t9  }
  { rank=same; b10; p10; c10; d10; r10; t10 }
  { rank=same; b11; p11; c11; d11; r11; t11 }

  // ── Phase 1 — Submit product (green) ──────────────────────────────────────
  edge [constraint=false, fontsize=9]
  b0 -> p0 [label="  POST /product  \n",                                   style=solid,  color="#198754", fontcolor="#198754"]
  p1 -> d1 [label="  INSERT product record  \n",                           style=solid,  color="#198754", fontcolor="#198754"]

  // ── Phase 2 — PubChem retrieval per unparsed ingredient (orange) ──────────
  // loop [for each unparsed ingredient in the product's ingredient list]
  p2 -> c2 [label="  GET compound / substance\l  ← loop: once per unparsed ingredient  \n", style=solid,  color="#EE7722", fontcolor="#EE7722"]
  c3 -> p3 [label="  JSON (hazards · names · labels · synonyms)  \n",     style=dashed, color="#EE7722", fontcolor="#EE7722"]
  p4 -> d4 [label="  INSERT ingredient + labels + names  \n",             style=solid,  color="#EE7722", fontcolor="#EE7722"]
  // end loop — all ingredients resolved; link them to the product
  p5 -> d5 [label="  INSERT product_ingredient links  \n",                style=solid,  color="#EE7722", fontcolor="#EE7722"]
  p6 -> b6 [label="  200 OK  \n",                                          style=dashed, color="#198754", fontcolor="#198754"]

  // ── Phase 3 — Page render (blue) ──────────────────────────────────────────
  b7  -> r7  [label="  GET /products  \n",                                 style=solid,  color="#4477CC", fontcolor="#4477CC"]
  r8  -> d8  [label="  SELECT product + full\l  ingredient list  \n",     style=solid,  color="#4477CC", fontcolor="#4477CC"]
  d9  -> r9  [label="  rows (product · ingredients\l  · labels · names)  \n", style=dashed, color="#4477CC", fontcolor="#4477CC"]
  r10 -> t10 [label="  exec template w/ ctx  \n",                         style=solid,  color="#4477CC", fontcolor="#4477CC"]
  t11 -> b11 [label="  HTML response  \n",                                 style=dashed, color="#4477CC", fontcolor="#4477CC"]
}

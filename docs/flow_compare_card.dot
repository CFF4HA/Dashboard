digraph flow_compare_client {
  rankdir=TB
  graph [
    label="UML Sequence — compare-product_card: Client-side Interactions (no HTTP)",
    labelloc=t, labeljust=l,
    fontname="Helvetica", fontsize=12,
    nodesep=2.0, ranksep=0.6,
    splines=polyline, pad=0.5
  ]
  node [fontname="Helvetica", fontsize=10, height=0.5]
  edge [fontname="Helvetica", fontsize=9, arrowsize=0.75]

  // ── Lifelines ─────────────────────────────────────────────────────────────
  { rank=min
    Browser [label="Browser",                            shape=rect, style="filled,rounded", fillcolor="#fff196"]
    CardJS  [label="CompareCard JS\ncpcToggleVote · compareRemoveProduct\nBootstrap Tab", shape=rect, style="filled,rounded", fillcolor="#fff9c4"]
    InvView [label="Investigation View JS\ninvUpdateBadIngredients",                      shape=rect, style="filled,rounded", fillcolor="#fff9c4"]
  }

  // ── Lifeline step nodes ───────────────────────────────────────────────────
  node [shape=point, width=0.04, height=0.04, label=""]

  // ── Lifeline chains ───────────────────────────────────────────────────────
  edge [style=dashed, arrowhead=none, color="#cccccc", weight=20]
  Browser -> b0 -> b1 -> b2 -> b3 -> b4 -> b5 -> b6 -> b7 -> b8
  CardJS  -> j0 -> j1 -> j2 -> j3 -> j4 -> j5 -> j6 -> j7 -> j8
  InvView -> v0 -> v1 -> v2 -> v3 -> v4 -> v5 -> v6 -> v7 -> v8

  // ── Step alignment ────────────────────────────────────────────────────────
  { rank=same; b0; j0; v0 }
  { rank=same; b1; j1; v1 }
  { rank=same; b2; j2; v2 }
  { rank=same; b3; j3; v3 }
  { rank=same; b4; j4; v4 }
  { rank=same; b5; j5; v5 }
  { rank=same; b6; j6; v6 }
  { rank=same; b7; j7; v7 }
  { rank=same; b8; j8; v8 }

  // ── [A] Vote: Good / Bad click ────────────────────────────────────────────
  edge [constraint=false, fontsize=9]
  b0 -> j0 [label="  Good / Bad click  ",                        style=solid,  color="#EE7722", fontcolor="#EE7722"]
  j1 -> b1 [label="  toggle active class on button  ",           style=dashed, color="#EE7722", fontcolor="#EE7722"]
  j2 -> v2 [label="  invUpdateBadIngredients(id, type, active)  ", style=solid, color="#EE7722", fontcolor="#EE7722"]
  v3 -> b3 [label="  highlight shared / unique ingredients  ",   style=dashed, color="#EE7722", fontcolor="#EE7722"]

  // ── [B] Remove: X click ───────────────────────────────────────────────────
  b4 -> j4 [label="  X (remove) click  ",                        style=solid,  color="#dc3545", fontcolor="#dc3545"]
  j5 -> b5 [label="  remove carousel item\nfire productRemoved event  ", style=dashed, color="#dc3545", fontcolor="#dc3545"]

  // ── [C] Tab: card body click ──────────────────────────────────────────────
  b6 -> j6 [label="  card body click  ",                         style=solid,  color="#6c757d", fontcolor="#6c757d"]
  j7 -> b7 [label="  Bootstrap Tab activate\nunique-tab-{id} panel  ", style=dashed, color="#6c757d", fontcolor="#6c757d"]
}

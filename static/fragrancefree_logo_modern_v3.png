<svg width="100%" viewBox="0 0 680 200" role="img" xmlns="http://www.w3.org/2000/svg" style="">
  <title style="fill:rgb(0, 0, 0);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:&quot;Anthropic Sans&quot;, -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto">FragranceFree modern logo v3</title>
  <desc style="fill:rgb(0, 0, 0);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:&quot;Anthropic Sans&quot;, -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto">Modern wordmark logo for FragranceFree showing Fragrance in dark forest green and free in italic lighter green with fr aligned under ce in Fragrance</desc>

  <text x="340" y="105" text-anchor="middle" font-family="Georgia, 'Playfair Display', serif" font-size="72" font-weight="400" letter-spacing="-1" fill="#1a2e1e" style="fill:rgb(26, 46, 30);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:Georgia, &quot;Playfair Display&quot;, serif;font-size:72px;font-weight:400;text-anchor:middle;dominant-baseline:auto">Fragrance</text>

  <text x="490" y="158" text-anchor="middle" font-family="Georgia, 'Playfair Display', serif" font-size="48" font-weight="400" font-style="italic" letter-spacing="2" fill="#4a7c59" style="fill:rgb(74, 124, 89);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:Georgia, &quot;Playfair Display&quot;, serif;font-size:48px;font-weight:400;font-style:italic;text-anchor:middle;dominant-baseline:auto">free</text>

</svg>